{% liquid
  assign promo_enabled = section.settings.enabled
  assign promo_text = section.settings.text
  assign promo_link = section.settings.link
%}

{% if promo_enabled and promo_text != blank %}
  <div
    id="promo-bar"
    class="bg-brand-dark text-brand-parchment text-center py-2 text-sm font-body tracking-wider"
  >
    {% if promo_link != blank %}
      <a href="{{ promo_link }}" class="promo-bar__link">
        <span>{{ promo_text }}</span>
      </a>
    {% else %}
      <span>{{ promo_text }}</span>
    {% endif %}
  </div>
{% endif %}

{% stylesheet %}
  #promo-bar .promo-bar__link {
    color: inherit;
    text-decoration: none;
  }

  #promo-bar .promo-bar__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
    text-decoration: underline;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Landing promo bar",
  "tag": "section",
  "class": "landing-promo-bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable promo bar",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Promo text",
      "default": "Free shipping on orders over $75 by owl post. Use code MAGIC25 for 25% off."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Promo link (optional)"
    }
  ],
  "presets": [{ "name": "Landing promo bar" }]
}
{% endschema %}
