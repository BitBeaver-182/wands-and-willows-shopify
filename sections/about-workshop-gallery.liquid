<section id="workshop" class="py-16 lg:py-24 bg-white px-5 lg:px-0">
  <div class="w-full max-w-md lg:max-w-[1200px] mx-auto lg:px-12">
    <div class="text-center mb-10 lg:mb-16">
      <h2 class="font-heading text-3xl lg:text-4xl text-brand-forest mb-3 lg:mb-4">{{ section.settings.title }}</h2>
      <div class="w-12 lg:w-16 h-0.5 bg-brand-gold mx-auto mb-5 lg:mb-6"></div>
      {% if section.settings.body != blank %}
        <p class="font-body text-brand-muted text-sm lg:text-base leading-relaxed max-w-2xl mx-auto">{{ section.settings.body }}</p>
      {% endif %}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 lg:gap-8">
      {% for block in section.blocks %}
        <div class="aspect-[4/3] overflow-hidden rounded-sm shadow-lg bg-brand-parchment" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 1200
              | image_tag: loading: 'lazy', class: 'w-full h-full object-cover'
            }}
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Workshop gallery",
  "tag": "section",
  "class": "about-workshop-gallery",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Inside the Workshop"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "A glimpse into where the magic happens - our Glasgow workshop where artisans bring dreams to life."
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Workshop image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Workshop gallery",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}
