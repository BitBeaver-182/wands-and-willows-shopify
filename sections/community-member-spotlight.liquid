<section id="member-spotlight" class="py-16 md:py-24 bg-brand-forest text-brand-parchment relative overflow-hidden">
  <div class="absolute inset-0 opacity-5">
    {% if section.settings.background != blank %}
      {{ section.settings.background | image_url: width: 2000 | image_tag: class: 'w-full h-full object-cover', loading: 'lazy', alt: '' }}
    {% endif %}
  </div>
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-12 relative z-10">
    <div class="text-center mb-12 md:mb-16">
      <h2 class="font-heading text-4xl mb-4">{{ section.settings.heading }}</h2>
      <div class="w-16 h-0.5 bg-brand-gold mx-auto"></div>
    </div>

    <div class="flex flex-col lg:flex-row items-center gap-12 max-w-5xl mx-auto">
      <div class="lg:w-1/3">
        <div class="aspect-square w-full max-w-sm mx-auto rounded-full overflow-hidden border-4 border-brand-gold/30">
          {% if section.settings.image != blank %}
            {{
              section.settings.image
              | image_url: width: 700
              | image_tag:
                class: 'w-full h-full object-cover',
                loading: 'lazy',
                alt: section.settings.name
            }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'w-full h-full object-cover text-brand-sand bg-brand-dark' }}
          {% endif %}
        </div>
      </div>

      <div class="lg:w-2/3 text-center lg:text-left">
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3 mb-4">
          <h3 class="font-heading text-3xl">{{ section.settings.name }}</h3>
          <span class="bg-brand-gold/20 text-brand-gold px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider">{{ section.settings.badge }}</span>
        </div>
        <p class="font-body text-brand-sand text-lg mb-6 font-light leading-relaxed">{{ section.settings.quote }}</p>
        <div class="grid grid-cols-3 gap-6 mb-8">
          {% for block in section.blocks %}
            <div {{ block.shopify_attributes }}>
              <div class="text-2xl font-heading text-brand-gold mb-1">{{ block.settings.value }}</div>
              <div class="text-xs text-brand-sand/70 uppercase tracking-wider">{{ block.settings.label }}</div>
            </div>
          {% endfor %}
        </div>
        {% if section.settings.link_label != blank %}
          <a href="{{ section.settings.link }}" class="inline-flex items-center gap-2 text-brand-gold hover:text-brand-goldHover font-medium transition-colors">
            {{ section.settings.link_label }} <i class="fa-solid fa-arrow-right text-sm" aria-hidden="true"></i>
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Member spotlight",
  "settings": [
    { "type": "image_picker", "id": "background", "label": "Background texture" },
    { "type": "image_picker", "id": "image", "label": "Member image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Member of the Month" },
    { "type": "text", "id": "name", "label": "Name", "default": "Emma Richardson" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "House of Wisdom" },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "Being part of this community has transformed how I experience the stories I love." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View Profile" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "spotlight_stat",
      "name": "Spotlight stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "156" },
        { "type": "text", "id": "label", "label": "Label", "default": "Posts Shared" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Community member spotlight",
      "blocks": [
        { "type": "spotlight_stat" },
        { "type": "spotlight_stat", "settings": { "value": "2.3K", "label": "Followers" } },
        { "type": "spotlight_stat", "settings": { "value": "3 yrs", "label": "Member Since" } }
      ]
    }
  ]
}
{% endschema %}
