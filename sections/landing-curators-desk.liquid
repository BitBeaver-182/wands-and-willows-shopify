<section id="curators-desk" class="py-24 bg-brand-parchment border-y border-brand-sand">
  <div class="max-w-[1440px] mx-auto px-6 lg:px-12">
    {% render 'landing-section-heading',
      title: section.settings.title,
      body: section.settings.body,
      class: 'mb-16'
    %}

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {% for block in section.blocks %}
        {% if block.settings.article != blank %}
          {% liquid
            assign badge_text = block.settings.article.metafields.blogpost.category.value | default: block.settings.article.blog.title
          %}
          {% render 'blog-article-card',
            article: block.settings.article,
            surface: 'white',
            layout: 'grid',
            show_meta: false,
            badge_text: badge_text,
            read_label: 'Read Article',
            image_height_class: 'h-64'
          %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Landing curator",
  "tag": "section",
  "class": "landing-curators-desk",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "article_card",
      "name": "Article card",
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "Article"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "The Curator's Desk"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Stories, insights, and magical findings from our head archivist.</p>"
    }
  ],
  "presets": [
    {
      "name": "Landing curator",
      "blocks": {
        "article_1": {
          "type": "article_card"
        },
        "article_2": {
          "type": "article_card"
        },
        "article_3": {
          "type": "article_card"
        }
      },
      "block_order": ["article_1", "article_2", "article_3"]
    }
  ]
}
{% endschema %}
