{% liquid
  assign image = section.settings.image
  assign image_alt = section.settings.image_alt
  assign eyebrow = section.settings.eyebrow
  assign title = section.settings.title
  assign body = section.settings.body
%}

<section id="subscription" class="py-0 flex flex-col lg:flex-row min-h-[600px]">
  <div class="lg:w-1/2 relative min-h-[400px]">
    {% if image != blank %}
      <img
        class="absolute inset-0 w-full h-full object-cover"
        src="{{ image | image_url: width: 1600 }}"
        alt="{{ image_alt | default: image.alt | escape }}"
        width="{{ image.width }}"
        height="{{ image.height }}"
        loading="lazy"
      >
    {% else %}
      {{ 'collection-2' | placeholder_svg_tag: 'absolute inset-0 w-full h-full object-cover bg-brand-sand text-brand-parchment' }}
    {% endif %}
  </div>
  <div class="lg:w-1/2 bg-brand-forest text-brand-parchment p-12 lg:p-24 flex flex-col justify-center">
    <span class="text-brand-gold font-body tracking-[0.2em] text-sm mb-4 uppercase">{{ eyebrow }}</span>
    <h2 class="font-heading text-4xl lg:text-5xl mb-6">{{ title }}</h2>
    <div class="font-body text-brand-sand text-lg mb-8 font-light leading-relaxed max-w-lg">
      {{ body }}
    </div>
    <ul class="space-y-4 mb-10 text-brand-sand font-body">
      {% for block in section.blocks %}
        <li class="flex items-center gap-3" {{ block.shopify_attributes }}>
          <i class="fa-solid fa-check text-brand-gold" aria-hidden="true"></i>
          <span>{{ block.settings.text }}</span>
        </li>
      {% endfor %}
    </ul>
    <div>
      {% render 'landing-button',
        label: section.settings.button_label,
        link: section.settings.button_link,
        style: section.settings.button_style,
        class: 'whitespace-nowrap'
      %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Landing subscription",
  "tag": "section",
  "class": "landing-subscription",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "feature_item",
      "name": "Feature item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "3-5 premium magical items per box"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Monthly Owl Post"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The Monthly Dose of Magic"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Receive a carefully curated parcel of exclusive merchandise, handcrafted apothecary items, and magical artifacts delivered to your door every month.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe Now - $45/mo"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        }
      ],
      "default": "primary"
    }
  ],
  "presets": [
    {
      "name": "Landing subscription",
      "blocks": {
        "feature_1": {
          "type": "feature_item",
          "settings": {
            "text": "3-5 premium magical items per box"
          }
        },
        "feature_2": {
          "type": "feature_item",
          "settings": {
            "text": "Exclusive items not sold in store"
          }
        },
        "feature_3": {
          "type": "feature_item",
          "settings": {
            "text": "Personalized to your chosen House"
          }
        }
      },
      "block_order": ["feature_1", "feature_2", "feature_3"]
    }
  ]
}
{% endschema %}
