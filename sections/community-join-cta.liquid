<section id="join-cta" class="py-16 md:py-24 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
    <i class="{{ section.settings.icon }} text-brand-gold text-5xl mb-6" aria-hidden="true"></i>
    <h2 class="font-heading text-4xl text-brand-forest mb-6">{{ section.settings.heading }}</h2>
    <p class="font-body text-brand-muted text-lg mb-10 max-w-2xl mx-auto leading-relaxed">{{ section.settings.text }}</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      {% for block in section.blocks %}
        {% render 'landing-button',
          label: block.settings.label,
          link: block.settings.link,
          style: block.settings.style,
          palette: block.settings.palette,
          full_width: true,
          class: 'sm:w-auto',
          open_in_new_tab: block.settings.open_in_new_tab
        %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Community join CTA",
  "settings": [
    { "type": "text", "id": "icon", "label": "Icon class", "default": "fa-solid fa-users" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Become Part of Our Circle" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Join thousands of magical enthusiasts sharing their stories, attending exclusive events, and connecting over a shared love of enchantment." }
  ],
  "blocks": [
    {
      "type": "cta_button",
      "name": "CTA button",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Create Free Account" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "primary", "label": "Primary" },
            { "value": "secondary", "label": "Secondary" }
          ],
          "default": "primary"
        },
        {
          "type": "select",
          "id": "palette",
          "label": "Palette",
          "options": [
            { "value": "auto", "label": "Auto" },
            { "value": "gold", "label": "Gold" },
            { "value": "forest", "label": "Forest" }
          ],
          "default": "gold"
        },
        { "type": "checkbox", "id": "open_in_new_tab", "label": "Open in new tab", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Community join CTA",
      "blocks": [
        { "type": "cta_button" },
        { "type": "cta_button", "settings": { "label": "Learn More", "style": "secondary", "palette": "auto" } }
      ]
    }
  ]
}
{% endschema %}
