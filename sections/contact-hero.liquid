<section id="hero-contact" class="relative w-full h-[400px] flex items-center justify-center overflow-hidden">
  <div class="absolute inset-0 z-0">
    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 2200
        | image_tag: loading: 'eager', class: 'w-full h-full object-cover'
      }}
    {% else %}
      <div class="w-full h-full bg-brand-forest"></div>
    {% endif %}
    <div class="absolute inset-0 bg-gradient-to-b from-brand-dark/70 via-brand-dark/50 to-brand-forest/70"></div>
  </div>

  <div class="relative z-10 max-w-4xl mx-auto px-6 text-center text-brand-parchment">
    {% if section.settings.eyebrow != blank %}
      <span class="block text-brand-gold font-body tracking-[0.2em] text-sm mb-4 uppercase">{{ section.settings.eyebrow }}</span>
    {% endif %}
    <h1 class="font-heading text-5xl md:text-6xl font-bold mb-4 leading-tight">{{ section.settings.title | default: page.title }}</h1>
    {% if section.settings.body != blank %}
      <p class="font-body text-lg text-brand-sand max-w-2xl mx-auto font-light">{{ section.settings.body }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Contact hero",
  "tag": "section",
  "class": "contact-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Reach Out"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Contact Us"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "We'd love to hear from you. Send us an owl, or use the form below."
    }
  ],
  "presets": [
    {
      "name": "Contact hero"
    }
  ]
}
{% endschema %}
