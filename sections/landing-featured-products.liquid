<script src="{{ 'embla-carousel.umd.js' | asset_url }}" defer></script>
<script>
  (() => {
    const init = (sectionEl) => {
      const viewport = sectionEl.querySelector('[data-embla-viewport]');
      const prevButton = sectionEl.querySelector('[data-embla-prev]');
      const nextButton = sectionEl.querySelector('[data-embla-next]');

      if (!viewport || !window.EmblaCarousel) return;

      const embla = window.EmblaCarousel(viewport, {
        align: 'start',
        containScroll: 'trimSnaps',
        loop: false,
      });

      const updateButtons = () => {
        if (prevButton) prevButton.disabled = !embla.canScrollPrev();
        if (nextButton) nextButton.disabled = !embla.canScrollNext();
      };

      if (prevButton) prevButton.addEventListener('click', () => embla.scrollPrev());
      if (nextButton) nextButton.addEventListener('click', () => embla.scrollNext());

      embla.on('select', updateButtons);
      embla.on('reInit', updateButtons);
      updateButtons();
    };

    const initAll = () => {
      document
        .querySelectorAll('[data-featured-products-section-id]')
        .forEach((sectionEl) => init(sectionEl));
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll, { once: true });
    } else {
      initAll();
    }
  })();
</script>

{% liquid
  assign selected_collection = section.settings.collection
  assign max_products = section.settings.max_products
%}

<section id="featured-products" class="py-24 bg-white" data-featured-products-section-id="{{ section.id }}">
  <div class="max-w-[1440px] mx-auto px-6 lg:px-12">
    <div class="flex justify-between items-end mb-12">
      {% render 'landing-section-heading', title: section.settings.title, body: section.settings.body, alignment: 'left' %}
      <div class="hidden md:flex gap-2" data-embla-controls>
        <button
          class="w-10 h-10 rounded-full border border-brand-sand flex items-center justify-center text-brand-forest hover:bg-brand-forest hover:text-white transition-colors"
          type="button"
          aria-label="{{ 'accessibility.slideshow_previous' | t }}"
          data-embla-prev
        >
          <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
        </button>
        <button
          class="w-10 h-10 rounded-full border border-brand-sand flex items-center justify-center text-brand-forest hover:bg-brand-forest hover:text-white transition-colors"
          type="button"
          aria-label="{{ 'accessibility.slideshow_next' | t }}"
          data-embla-next
        >
          <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </button>
      </div>
    </div>

    <div class="embla" data-embla-viewport>
      <div class="embla__container" data-embla-container>
        {% if selected_collection != blank and selected_collection.products_count > 0 %}
          {% for product in selected_collection.products limit: max_products %}
            <div class="embla__slide">
              {% render 'landing-featured-product-card', product: product %}
            </div>
          {% endfor %}
        {% else %}
          {% for index in (1..4) %}
            <div class="embla__slide">
              <div class="group relative bg-brand-parchment rounded-sm p-4 border border-brand-sand/50">
                <div class="aspect-[4/5] bg-white rounded-sm overflow-hidden mb-4 relative flex items-center justify-center">
                  {{ 'product-apparel-1' | placeholder_svg_tag: 'w-full h-full object-cover mix-blend-multiply p-4 text-brand-sand' }}
                </div>
                <div class="space-y-2">
                  <div class="flex justify-between items-start gap-4">
                    <h3 class="font-heading text-lg text-brand-forest font-medium leading-tight">{{ 'content.product_card_placeholder' | t }}</h3>
                    <span class="font-body font-semibold text-brand-text">$48.00</span>
                  </div>
                  <button class="w-full mt-4 py-3 bg-brand-forest text-white font-medium text-sm rounded-sm flex items-center justify-center gap-2" type="button" disabled>
                    <i class="fa-solid fa-cart-plus" aria-hidden="true"></i> {{ 'actions.add_to_cart' | t }}
                  </button>
                </div>
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>

    <div class="mt-12 text-center">
      {% if section.settings.button_label != blank and section.settings.button_link != blank %}
        {% render 'landing-button',
          label: section.settings.button_label,
          link: section.settings.button_link,
          style: section.settings.button_style
        %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Landing featured",
  "tag": "section",
  "class": "landing-featured-products",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Curated Artifacts"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Hand-selected magical goods for your collection.</p>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Max products",
      "min": 1,
      "max": 16,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View All Artifacts"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        }
      ],
      "default": "secondary"
    }
  ],
  "presets": [{ "name": "Landing featured" }]
}
{% endschema %}

{% stylesheet %}
  .embla {
    overflow: hidden;
  }

  .embla__container {
    display: flex;
    gap: 2rem; /* matches gap-8 */
  }

  .embla__slide {
    flex: 0 0 100%;
  }

  @media (min-width: 640px) {
    .embla__slide {
      flex-basis: calc(50% - 1rem);
    }
  }

  @media (min-width: 1024px) {
    .embla__slide {
      flex-basis: calc(25% - 1.5rem);
    }
  }
{% endstylesheet %}
