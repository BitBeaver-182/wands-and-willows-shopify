<script src="{{ 'cart-page.js' | asset_url }}" defer></script>

{%- liquid
  assign free_shipping_threshold = section.settings.free_shipping_threshold | times: 100
  assign remaining_for_free_shipping = free_shipping_threshold | minus: cart.total_price
  assign remaining_for_free_shipping_money = remaining_for_free_shipping | money
  assign free_shipping_progress = cart.total_price | times: 100 | divided_by: free_shipping_threshold
  if free_shipping_progress > 100
    assign free_shipping_progress = 100
  endif
-%}

<section id="basket-main" class="py-10 lg:py-16 bg-brand-parchment min-h-[600px]">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-12">
    <nav class="flex items-center gap-2 text-sm font-body text-brand-muted mb-8" aria-label="{{ 'content.your_cart' | t }}">
      <a href="{{ routes.root_url }}" class="hover:text-brand-gold transition-colors">{{ shop.name }}</a>
      <i class="fa-solid fa-chevron-right text-xs" aria-hidden="true"></i>
      <span class="text-brand-forest font-medium">{{ 'content.your_cart' | t }}</span>
    </nav>

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-10 lg:mb-12">
      <h1 class="font-heading text-4xl text-brand-forest">{{ section.settings.heading }}</h1>
      <a href="{{ routes.all_products_collection_url }}" class="font-body text-sm text-brand-muted hover:text-brand-gold transition-colors flex items-center gap-2">
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
        {{ 'actions.continue_shopping' | t }}
      </a>
    </div>

    {% if cart == empty %}
      <div class="bg-white border border-brand-sand rounded-sm p-10 text-center">
        <h2 class="font-heading text-3xl text-brand-forest mb-4">{{ 'content.your_cart_is_empty' | t }}</h2>
        {% render 'landing-button',
          label: 'actions.continue_shopping' | t,
          link: routes.all_products_collection_url,
          style: 'primary',
          palette: 'forest'
        %}
      </div>
    {% else %}
      {% if section.settings.show_rewards %}
        <div class="bg-gradient-to-r from-brand-gold/20 via-brand-gold/10 to-brand-gold/5 border-2 border-brand-gold/40 rounded-sm p-5 lg:p-6 mb-8">
          <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
            <div class="flex items-center gap-5 lg:gap-6">
              <div class="w-14 h-14 lg:w-16 lg:h-16 bg-brand-gold rounded-full flex items-center justify-center flex-shrink-0">
                <i class="fa-solid fa-crown text-white text-2xl" aria-hidden="true"></i>
              </div>
              <div>
                <h2 class="font-heading text-2xl text-brand-forest mb-2">{{ section.settings.rewards_heading }}</h2>
                <p class="font-body text-sm text-brand-forest mb-2">{{ section.settings.rewards_text }}</p>
                <div class="flex items-center gap-4">
                  <div class="flex-1 bg-white/50 rounded-full h-3 w-48 lg:w-72 overflow-hidden">
                    <div class="bg-brand-gold h-full rounded-full" style="width: {{ section.settings.rewards_progress }}%"></div>
                  </div>
                  <span class="font-body text-xs text-brand-forest whitespace-nowrap">{{ section.settings.rewards_progress_text }}</span>
                </div>
              </div>
            </div>
            {% if section.settings.rewards_button_label != blank %}
              <button class="px-6 py-3 bg-brand-gold text-white font-semibold text-sm rounded-sm hover:bg-brand-goldHover transition-colors flex items-center justify-center gap-2" type="button">
                <i class="fa-solid fa-gift" aria-hidden="true"></i>
                {{ section.settings.rewards_button_label }}
              </button>
            {% endif %}
          </div>
        </div>
      {% endif %}

      <wand-cart-form class="block">
        <form action="{{ routes.cart_url }}" method="post" id="cart">
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12">
            <div id="basket-items" class="lg:col-span-2 space-y-6">
              {% for item in cart.items %}
                <article class="bg-white border border-brand-sand rounded-sm p-4 lg:p-6 flex flex-col sm:flex-row gap-5 lg:gap-6 items-start hover:shadow-md transition-all">
                  <a href="{{ item.url }}" class="w-full sm:w-32 h-48 sm:h-32 bg-brand-sand rounded-sm flex-shrink-0 p-4 flex items-center justify-center">
                    {% if item.image != blank %}
                      {{
                        item.image
                        | image_url: width: 400
                        | image_tag:
                          class: 'w-full h-full object-contain mix-blend-multiply',
                          loading: 'lazy',
                          alt: item.image.alt | default: item.product.title
                      }}
                    {% else %}
                      {{ 'product-apparel-1' | placeholder_svg_tag: 'w-full h-full object-contain text-brand-muted' }}
                    {% endif %}
                  </a>

                  <div class="flex-1 w-full">
                    <div class="flex items-start justify-between gap-4 mb-3">
                      <div>
                        <h2 class="font-heading text-xl text-brand-forest mb-2">
                          <a href="{{ item.url }}">{{ item.product.title }}</a>
                        </h2>
                        {% unless item.product.has_only_default_variant %}
                          {% for option in item.options_with_values %}
                            <p class="font-body text-sm text-brand-forest{% unless forloop.last %} mb-1{% endunless %}">
                              {{ option.name }}: {{ option.value }}
                            </p>
                          {% endfor %}
                        {% endunless %}
                        {% if section.settings.show_points %}
                          <div class="flex items-center gap-2 mt-2">
                            <i class="fa-solid fa-star text-brand-gold text-xs" aria-hidden="true"></i>
                            <span class="font-body text-xs text-brand-gold font-semibold">+{{ item.final_line_price | divided_by: 100 }} {{ section.settings.points_label }}</span>
                          </div>
                        {% endif %}
                      </div>
                      <a href="{{ item.url_to_remove }}" class="text-brand-muted hover:text-red-500 transition-colors" aria-label="{{ 'accessibility.remove_item' | t: title: item.title }}">
                        <i class="fa-regular fa-trash-can text-lg" aria-hidden="true"></i>
                      </a>
                    </div>

                    <div class="flex items-center justify-between gap-4 mt-6">
                      <div class="flex items-center border border-brand-sand rounded-sm">
                        <button class="px-4 py-2 hover:bg-brand-sand/30 transition-colors" type="button" data-cart-line="{{ forloop.index }}" data-cart-quantity-step="-1">
                          <i class="fa-solid fa-minus text-sm" aria-hidden="true"></i>
                        </button>
                        <input
                          class="w-16 text-center border-x border-brand-sand py-2 focus:outline-none font-body"
                          type="number"
                          name="updates[]"
                          value="{{ item.quantity }}"
                          min="0"
                          data-cart-quantity="{{ forloop.index }}"
                          aria-label="{{ 'accessibility.quantity' | t }}"
                        >
                        <button class="px-4 py-2 hover:bg-brand-sand/30 transition-colors" type="button" data-cart-line="{{ forloop.index }}" data-cart-quantity-step="1">
                          <i class="fa-solid fa-plus text-sm" aria-hidden="true"></i>
                        </button>
                      </div>
                      <div class="text-right">
                        <p class="font-heading text-2xl text-brand-forest">{{ item.final_line_price | money }}</p>
                        {% if item.original_line_price > item.final_line_price %}
                          <p class="font-body text-sm text-brand-muted line-through">{{ item.original_line_price | money }}</p>
                        {% elsif item.quantity > 1 %}
                          <p class="font-body text-sm text-brand-muted">{{ item.final_price | money }} {{ 'content.quantity_per_item' | t }}</p>
                        {% endif %}
                      </div>
                    </div>
                  </div>
                </article>
              {% endfor %}

              {% if section.settings.show_gift_note %}
                <div class="bg-white border border-brand-gold/40 rounded-sm p-6">
                  <label class="flex items-start gap-4" for="CartNote">
                    <i class="fa-solid fa-gift text-brand-gold text-2xl mt-1" aria-hidden="true"></i>
                    <span>
                      <span class="block font-heading text-lg text-brand-forest mb-2">{{ section.settings.gift_note_heading }}</span>
                      <span class="block font-body text-sm text-brand-forest mb-4">{{ section.settings.gift_note_text }}</span>
                    </span>
                  </label>
                  <textarea id="CartNote" name="note" rows="3" class="w-full border border-brand-sand rounded-sm px-4 py-3 focus:outline-none focus:border-brand-gold font-body text-sm">{{ cart.note }}</textarea>
                </div>
              {% endif %}

              <div class="bg-white border border-brand-sand rounded-sm p-6">
                <h2 class="font-heading text-lg text-brand-forest mb-4 flex items-center gap-3">
                  <i class="fa-solid fa-tag text-brand-gold" aria-hidden="true"></i>
                  {{ section.settings.discount_heading }}
                </h2>
                <div class="flex flex-col sm:flex-row gap-3">
                  <input type="text" name="discount" placeholder="{{ section.settings.discount_placeholder }}" class="flex-1 border border-brand-sand rounded-sm px-4 py-3 focus:outline-none focus:border-brand-gold font-body text-sm">
                  <button class="px-8 py-3 bg-brand-forest text-white font-medium text-sm rounded-sm hover:bg-brand-dark transition-colors whitespace-nowrap" type="submit">
                    {{ 'actions.apply' | t }}
                  </button>
                </div>
              </div>
            </div>

            <aside class="lg:col-span-1">
              <div class="bg-white border border-brand-sand rounded-sm p-6 lg:p-8 sticky top-24">
                <h2 class="font-heading text-2xl text-brand-forest mb-6">{{ section.settings.summary_heading }}</h2>

                <div class="space-y-4 mb-6 pb-6 border-b border-brand-sand">
                  <div class="flex items-center justify-between font-body text-sm">
                    <span class="text-brand-forest">{{ 'content.product_subtotal' | t }} ({{ 'content.item_count' | t: count: cart.item_count }})</span>
                    <span class="text-brand-forest font-medium">{{ cart.items_subtotal_price | money }}</span>
                  </div>
                  <div class="flex items-center justify-between font-body text-sm">
                    <span class="text-brand-forest">{{ section.settings.shipping_label }}</span>
                    <span class="text-brand-forest font-medium">{{ section.settings.shipping_value }}</span>
                  </div>
                  <div class="flex items-center justify-between font-body text-sm">
                    <span class="text-brand-forest">{{ section.settings.tax_label }}</span>
                    <span class="text-brand-forest font-medium">{{ section.settings.tax_value }}</span>
                  </div>
                  <div class="{% if remaining_for_free_shipping <= 0 %}bg-green-50 border-green-200{% else %}bg-brand-gold/10 border-brand-gold/30{% endif %} border rounded-sm p-3 flex items-start gap-2">
                    <i class="fa-solid {% if remaining_for_free_shipping <= 0 %}fa-check-circle text-green-600{% else %}fa-truck text-brand-gold{% endif %} mt-0.5" aria-hidden="true"></i>
                    <p class="font-body text-xs {% if remaining_for_free_shipping <= 0 %}text-green-800{% else %}text-brand-forest{% endif %}">
                      {% if remaining_for_free_shipping <= 0 %}
                        {{ section.settings.free_shipping_unlocked_text }}
                      {% else %}
                        {{ section.settings.free_shipping_remaining_text | replace: '[amount]', remaining_for_free_shipping_money }}
                      {% endif %}
                    </p>
                  </div>
                  <div class="bg-brand-gold/10 border border-brand-gold/30 rounded-sm p-3 flex items-start gap-2">
                    <i class="fa-solid fa-star text-brand-gold mt-0.5" aria-hidden="true"></i>
                    <p class="font-body text-xs text-brand-forest">{{ section.settings.earn_points_text }}</p>
                  </div>
                </div>

                <div class="flex items-center justify-between mb-8 pb-6 border-b border-brand-sand">
                  <span class="font-heading text-xl text-brand-forest">{{ 'content.total_items' | t }}</span>
                  <span class="font-heading text-3xl text-brand-forest">{{ cart.total_price | money }}</span>
                </div>

                <button class="w-full bg-brand-gold text-white py-4 rounded-sm font-semibold text-base hover:bg-brand-goldHover transition-colors mb-3 flex items-center justify-center gap-3" type="submit" name="checkout">
                  <i class="fa-solid fa-lock" aria-hidden="true"></i>
                  {{ 'content.checkout' | t }}
                </button>

                <div class="mt-8 pt-6 border-t border-brand-sand space-y-4">
                  {% for block in section.blocks %}
                    <div class="flex items-start gap-3" {{ block.shopify_attributes }}>
                      <i class="{{ block.settings.icon }} text-brand-gold text-lg mt-1" aria-hidden="true"></i>
                      <div>
                        <h3 class="font-body font-semibold text-brand-forest text-sm mb-1">{{ block.settings.heading }}</h3>
                        <p class="font-body text-xs text-brand-forest">{{ block.settings.text }}</p>
                      </div>
                    </div>
                  {% endfor %}
                </div>

                <div class="mt-6 pt-6 border-t border-brand-sand">
                  <p class="font-body text-xs text-brand-forest text-center">{{ section.settings.payment_heading }}</p>
                  <div class="flex items-center justify-center gap-3 mt-3">
                    <i class="fa-brands fa-cc-visa text-2xl text-brand-muted" aria-hidden="true"></i>
                    <i class="fa-brands fa-cc-mastercard text-2xl text-brand-muted" aria-hidden="true"></i>
                    <i class="fa-brands fa-cc-amex text-2xl text-brand-muted" aria-hidden="true"></i>
                    <i class="fa-brands fa-cc-paypal text-2xl text-brand-muted" aria-hidden="true"></i>
                  </div>
                </div>
              </div>
            </aside>
          </div>
        </form>
      </wand-cart-form>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Cart shell",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Magical Basket"
    },
    {
      "type": "checkbox",
      "id": "show_rewards",
      "label": "Show rewards panel",
      "default": true
    },
    {
      "type": "text",
      "id": "rewards_heading",
      "label": "Rewards heading",
      "default": "Wizarding Rewards Member"
    },
    {
      "type": "text",
      "id": "rewards_text",
      "label": "Rewards text",
      "default": "You have points available toward your next reward."
    },
    {
      "type": "range",
      "id": "rewards_progress",
      "label": "Rewards progress",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 49
    },
    {
      "type": "text",
      "id": "rewards_progress_text",
      "label": "Rewards progress text",
      "default": "255 points to next reward"
    },
    {
      "type": "text",
      "id": "rewards_button_label",
      "label": "Rewards button label",
      "default": "Redeem Points"
    },
    {
      "type": "checkbox",
      "id": "show_points",
      "label": "Show line item points",
      "default": true
    },
    {
      "type": "text",
      "id": "points_label",
      "label": "Points label",
      "default": "points"
    },
    {
      "type": "checkbox",
      "id": "show_gift_note",
      "label": "Show gift note",
      "default": true
    },
    {
      "type": "text",
      "id": "gift_note_heading",
      "label": "Gift note heading",
      "default": "Add a Gift Note"
    },
    {
      "type": "textarea",
      "id": "gift_note_text",
      "label": "Gift note text",
      "default": "Make this order extra special with a personalized message."
    },
    {
      "type": "text",
      "id": "discount_heading",
      "label": "Discount heading",
      "default": "Apply Discount Code"
    },
    {
      "type": "text",
      "id": "discount_placeholder",
      "label": "Discount placeholder",
      "default": "Enter code"
    },
    {
      "type": "text",
      "id": "summary_heading",
      "label": "Summary heading",
      "default": "Order Summary"
    },
    {
      "type": "range",
      "id": "free_shipping_threshold",
      "label": "Free shipping threshold",
      "min": 0,
      "max": 250,
      "step": 5,
      "default": 75
    },
    {
      "type": "text",
      "id": "shipping_label",
      "label": "Shipping label",
      "default": "Shipping"
    },
    {
      "type": "text",
      "id": "shipping_value",
      "label": "Shipping value",
      "default": "Calculated at checkout"
    },
    {
      "type": "text",
      "id": "tax_label",
      "label": "Tax label",
      "default": "Estimated Tax"
    },
    {
      "type": "text",
      "id": "tax_value",
      "label": "Tax value",
      "default": "Calculated at checkout"
    },
    {
      "type": "text",
      "id": "free_shipping_unlocked_text",
      "label": "Free shipping unlocked text",
      "default": "You're eligible for free shipping!"
    },
    {
      "type": "text",
      "id": "free_shipping_remaining_text",
      "label": "Free shipping remaining text",
      "default": "Add [amount] more for free shipping."
    },
    {
      "type": "text",
      "id": "earn_points_text",
      "label": "Earn points text",
      "default": "You'll earn points with this purchase."
    },
    {
      "type": "text",
      "id": "payment_heading",
      "label": "Payment heading",
      "default": "We accept"
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon class",
          "default": "fa-solid fa-truck"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Free Shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Delivered in 3-5 days"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cart shell",
      "blocks": [
        {
          "type": "trust_item"
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "fa-solid fa-shield-halved",
            "heading": "Secure Checkout",
            "text": "Your payment info is protected."
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "fa-solid fa-rotate-left",
            "heading": "Easy Returns",
            "text": "30-day return policy."
          }
        }
      ]
    }
  ]
}
{% endschema %}
