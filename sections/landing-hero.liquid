{% liquid
  assign hero_id = section.settings.custom_id | default: 'hero'
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign body = section.settings.body
%}

<section
  id="{{ hero_id }}"
  class="relative w-full h-[800px] flex items-center justify-center overflow-hidden"
>
  {% if section.settings.background_image != blank %}
    <div class="absolute inset-0 z-0">
      {{
        section.settings.background_image
        | image_url: width: 2400
        | image_tag:
          class: 'w-full h-full object-cover',
          loading: 'lazy',
          fetchpriority: 'low',
          alt: section.settings.background_image_alt
      }}
      <div class="absolute inset-0 bg-gradient-to-b from-brand-dark/60 via-brand-dark/40 to-brand-forest/80"></div>
    </div>
  {% endif %}

  <div class="relative z-10 max-w-4xl mx-auto px-6 text-center text-brand-parchment">
    {% render 'landing-section-heading',
      eyebrow: eyebrow,
      title: heading,
      title_tag: 'div',
      body: body,
      show_divider: false,
      class: 'text-brand-parchment [&_.font-heading]:text-5xl [&_.font-heading]:md:text-7xl [&_.font-heading]:font-bold [&_.font-heading]:leading-tight [&_.font-body]:text-lg [&_.font-body]:md:text-xl [&_.font-body]:text-brand-sand [&_.font-body]:mb-10 [&_.font-body]:font-light [&_.font-body]:leading-relaxed'
    %}

    {% if section.blocks.size > 0 %}
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        {% for block in section.blocks %}
          {% render 'landing-button',
            label: block.settings.label,
            link: block.settings.link,
            style: block.settings.style,
            full_width: true,
            open_in_new_tab: block.settings.open_in_new_tab,
            class: 'sm:w-auto',
            icon: block.settings.icon
          %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Landing hero",
  "tag": "section",
  "class": "landing-hero",
  "max_blocks": 2,
  "blocks": [
    {
      "type": "cta_button",
      "name": "CTA button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shop Collections"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "secondary",
              "label": "Secondary"
            }
          ],
          "default": "primary"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open in new tab",
          "default": false
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Font Awesome icon class"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "custom_id",
      "label": "Section ID",
      "default": "hero"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "background_image_alt",
      "label": "Background image alt text",
      "default": "Hero background image",
      "info": "Describe the image for screen readers."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Curated Enchantments"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Bring Magic Into<br>Your Everyday</p>"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>Discover our curated collection of official merchandise, handcrafted wands, and artisanal goods inspired by the world's most beloved magical realms.</p>"
    },
    {
      "type": "header",
      "content": "Buttons"
    }
  ],
  "presets": [
    {
      "name": "Landing hero",
      "blocks": {
        "primary_cta": {
          "type": "cta_button",
          "settings": {
            "label": "Shop Collections",
            "style": "primary"
          }
        },
        "secondary_cta": {
          "type": "cta_button",
          "settings": {
            "label": "Explore Wands",
            "style": "secondary"
          }
        }
      },
      "block_order": ["primary_cta", "secondary_cta"]
    }
  ]
}
{% endschema %}
