{% if section.settings.collection != blank and section.settings.collection.products_count > 0 %}
  <section id="you-may-like" class="py-16 bg-white border-t border-brand-sand">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-12">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-10 lg:mb-12">
        <div>
          <h2 class="font-heading text-3xl text-brand-forest mb-2">{{ section.settings.heading }}</h2>
          <p class="font-body text-sm text-brand-muted">{{ section.settings.text }}</p>
        </div>
        {% if section.settings.show_arrows %}
          <div class="hidden sm:flex gap-2">
            <span class="w-10 h-10 rounded-full border border-brand-sand flex items-center justify-center text-brand-muted">
              <i class="fa-solid fa-arrow-left text-sm" aria-hidden="true"></i>
            </span>
            <span class="w-10 h-10 rounded-full border border-brand-sand flex items-center justify-center text-brand-muted">
              <i class="fa-solid fa-arrow-right text-sm" aria-hidden="true"></i>
            </span>
          </div>
        {% endif %}
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {% for product in section.settings.collection.products limit: section.settings.product_limit %}
          {% render 'collection-product-card', product: product %}
        {% endfor %}
      </div>

      {% if section.settings.show_button %}
        <div class="mt-12 flex justify-center">
          {% render 'landing-button',
            label: section.settings.button_label,
            link: section.settings.collection.url,
            style: 'secondary',
            class: 'px-8 py-3 text-sm uppercase tracking-widest bg-white'
          %}
        </div>
      {% endif %}
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Cart related products",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like..."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Expand your magical range."
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Product limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show decorative arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show collection button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View All Artifacts"
    }
  ],
  "presets": [
    {
      "name": "Cart related products"
    }
  ]
}
{% endschema %}
