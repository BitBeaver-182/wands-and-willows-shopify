<section id="shop-by-house" class="py-24 bg-brand-parchment">
  <div class="max-w-[1440px] mx-auto px-6 lg:px-12">
    {% render 'landing-section-heading', title: section.settings.title, class: 'mb-16' %}

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {% for block in section.blocks limit: 4 %}
        {% liquid
          assign card_collection = block.settings.collection
          assign card_href = '#'
          assign card_title = ''
          assign card_description = ''
          assign card_image = blank

          if card_collection != blank
            assign card_href = card_collection.url
            assign card_title = card_collection.title
            assign card_description = card_collection.description | strip_html | strip
            assign card_image = card_collection.featured_image | default: card_collection.image
          endif
        %}

        <a
          href="{{ card_href }}"
          class="group relative h-[450px] overflow-hidden rounded-sm card-hover"
          {{ block.shopify_attributes }}
        >
          {% if card_image != blank %}
            {{
              card_image
              | image_url: width: 1600
              | image_tag:
                class: 'w-full h-full object-cover transition-transform duration-700 group-hover:scale-105',
                loading: 'lazy',
                fetchpriority: 'low',
                alt: card_image.alt | default: card_title
            }}
          {% else %}
            <div class="w-full h-full bg-brand-forest/80" aria-hidden="true"></div>
          {% endif %}
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
          <div class="absolute bottom-0 left-0 p-8 w-full">
            {% if card_title != blank %}
              <h3 class="font-heading text-2xl text-white mb-2">{{ card_title }}</h3>
            {% endif %}
            {% if card_description != blank %}
              <div class="font-body text-brand-sand text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300 transform translate-y-4 group-hover:translate-y-0">
                {{ card_description }}
              </div>
            {% endif %}
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Landing houses",
  "tag": "section",
  "class": "landing-shop-by-house",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Shop by House"
    }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "featured_collection",
      "name": "Featured collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Landing houses",
      "blocks": {
        "card_1": {
          "type": "featured_collection",
          "settings": {}
        },
        "card_2": {
          "type": "featured_collection",
          "settings": {}
        },
        "card_3": {
          "type": "featured_collection",
          "settings": {}
        },
        "card_4": {
          "type": "featured_collection",
          "settings": {}
        }
      },
      "block_order": ["card_1", "card_2", "card_3", "card_4"]
    }
  ]
}
{% endschema %}
