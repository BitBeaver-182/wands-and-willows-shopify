<section id="story-hero" class="relative w-full h-[500px] lg:h-[700px] flex items-center justify-center overflow-hidden">
  <div class="absolute inset-0 z-0">
    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag: loading: 'eager', class: 'w-full h-full object-cover'
      }}
    {% else %}
      <div class="w-full h-full bg-brand-forest"></div>
    {% endif %}
    <div class="absolute inset-0 bg-gradient-to-b from-brand-dark/70 via-brand-dark/50 to-brand-forest/70"></div>
  </div>

  <div class="relative z-10 w-full max-w-4xl mx-auto px-5 lg:px-6 text-center text-brand-parchment">
    {% if section.settings.eyebrow != blank %}
      <span class="block text-brand-gold font-body tracking-[0.15em] lg:tracking-[0.2em] text-xs lg:text-sm mb-3 lg:mb-4 uppercase">
        {{ section.settings.eyebrow }}
      </span>
    {% endif %}
    <h1 class="font-heading text-4xl lg:text-7xl md:text-6xl font-bold mb-4 lg:mb-6 leading-tight">
      {{ section.settings.title | default: page.title }}
    </h1>
    {% if section.settings.body != blank %}
      <p class="font-body text-base lg:text-xl text-brand-sand max-w-sm lg:max-w-2xl mx-auto font-light leading-relaxed">
        {{ section.settings.body }}
      </p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "About hero",
  "tag": "section",
  "class": "about-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Est. 2019"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Our Story"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "A journey from a single handcrafted wand to a thriving community of magic-makers and dreamers."
    }
  ],
  "presets": [
    {
      "name": "About hero"
    }
  ]
}
{% endschema %}
