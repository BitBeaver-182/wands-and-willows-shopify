<section id="common-room" class="py-24 bg-brand-parchment border-y border-brand-sand">
  <div class="max-w-[1440px] mx-auto px-6 lg:px-12">
    <div class="text-center mb-16">
      <h2 class="font-heading text-4xl text-brand-forest mb-4">The Common Room</h2>
      <div class="w-16 h-0.5 bg-brand-gold mx-auto mb-6"></div>
      <p class="font-body text-brand-muted max-w-2xl mx-auto">
        See how our community brings magic into their everyday lives. Tag us to be featured.
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="group relative aspect-square overflow-hidden rounded-sm">
        <img
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          src="https://storage.googleapis.com/uxpilot-auth.appspot.com/b924168c24-8e6728b54876727d2976.png"
          alt="user generated content showing magical setup"
        >
        <div class="absolute inset-0 bg-brand-forest/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
          <i class="fa-brands fa-instagram text-white text-3xl" aria-hidden="true"></i>
        </div>
      </div>
      <div class="group relative aspect-square overflow-hidden rounded-sm">
        <img
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          src="https://storage.googleapis.com/uxpilot-auth.appspot.com/fd23b53748-52dc6f8ed6830fce6874.png"
          alt="user generated content showing wand collection"
        >
        <div class="absolute inset-0 bg-brand-forest/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
          <i class="fa-brands fa-instagram text-white text-3xl" aria-hidden="true"></i>
        </div>
      </div>
      <div class="group relative aspect-square overflow-hidden rounded-sm">
        <img
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          src="https://storage.googleapis.com/uxpilot-auth.appspot.com/af0e3f0348-daab6d0bab4d9bbe518e.png"
          alt="user generated content showing reading nook"
        >
        <div class="absolute inset-0 bg-brand-forest/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
          <i class="fa-brands fa-instagram text-white text-3xl" aria-hidden="true"></i>
        </div>
      </div>
      <div class="group relative aspect-square overflow-hidden rounded-sm">
        <img
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          src="https://storage.googleapis.com/uxpilot-auth.appspot.com/ad23f1cf92-3d8a0dd85349a36be390.png"
          alt="user generated content showing potion bottles"
        >
        <div class="absolute inset-0 bg-brand-forest/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
          <i class="fa-brands fa-instagram text-white text-3xl" aria-hidden="true"></i>
        </div>
      </div>
    </div>

    <div class="mt-12 text-center">
      <a
        class="px-8 py-3 bg-transparent border-2 border-brand-forest text-brand-forest font-medium hover:bg-brand-forest hover:text-white transition-colors rounded-sm inline-block"
        href="#"
      >
        Follow @WandAndWillow
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Landing community",
  "tag": "section",
  "class": "landing-common-room",
  "settings": [],
  "presets": [{ "name": "Landing community" }]
}
{% endschema %}

