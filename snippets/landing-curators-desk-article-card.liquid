{% doc %}
  Curator article card

  @param article {Object} Article object (required)
{% enddoc %}

{% liquid
  assign article_title = article.title
  assign article_url = article.url
  assign article_excerpt = article.excerpt_or_content | strip_html | truncatewords: 24
  assign badge_text = article.metafields.blogpost.category.value | default: article.blog.title
%}

<article class="bg-white rounded-sm overflow-hidden shadow-sm hover:shadow-md transition-shadow">
  <div class="h-64 overflow-hidden">
    {% if article.image != blank %}
      <img
        class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
        src="{{ article.image | image_url: width: 960 }}"
        alt="{{ article.image.alt | default: article_title | escape }}"
        width="{{ article.image.width }}"
        height="{{ article.image.height }}"
        loading="lazy"
      >
    {% else %}
      <div class="w-full h-full bg-brand-sand/40" aria-hidden="true"></div>
    {% endif %}
  </div>
  <div class="p-8">
    <span class="text-brand-gold text-xs font-bold uppercase tracking-widest mb-3 block">
      {{ badge_text }}
    </span>
    <h3 class="font-heading text-2xl text-brand-forest mb-3">{{ article_title }}</h3>
    <p class="font-body text-brand-text/80 text-sm mb-6 line-clamp-3">
      {{ article_excerpt }}
    </p>
    <a href="{{ article_url }}" class="text-brand-forest font-medium text-sm hover:text-brand-gold flex items-center gap-2 transition-colors">
      Read Article <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i>
    </a>
  </div>
</article>
